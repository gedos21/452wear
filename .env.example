# 452WEAR ortam değişkenleri. Kopyala: cp .env.example .env.local
# Vercel/Cloudflare'de aynı adlarla tanımlanır.

# Neon Postgres bağlantısı (Neon → Connect → "Pooled connection" adresi)
DATABASE_URL=

# Oturum imza anahtarı: `openssl rand -base64 32` ile üret, kimseyle paylaşma
BETTER_AUTH_SECRET=
# Sitenin adresi. Lokal: http://localhost:3000 · canlı: https://452wear.com
BETTER_AUTH_URL=http://localhost:3000

# Google ile giriş (Google Cloud → APIs & Services → Credentials).
# Boş bırakılırsa "Google ile devam et" butonu gizlenir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Şifre sıfırlama e-postası (resend.com). Boşsa geliştirmede e-posta
# terminale yazılır; canlıda sıfırlama isteği hata verir.
RESEND_API_KEY=
EMAIL_FROM="452WEAR <hesap@452wear.com>"

# Admin paneline girebilen hesaplar (virgülle ayrılmış). Hesabın e-postası
# doğrulanmış olmalı (Google ile giriş).
ADMIN_EMAILS=
